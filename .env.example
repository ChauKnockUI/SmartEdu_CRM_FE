# API cùng origin/subdomain với FE (BE nhận diện trung tâm từ Host).
# Dev: Vite proxy /api -> http://localhost:3000, truy cập FE qua http://demo.localhost:5173
VITE_API_BASE_URL=/api
VITE_ENV_MODE=development

# Dev: đổi địa chỉ BE mà Vite proxy tới (mặc định http://localhost:3000)
# VITE_DEV_PROXY_TARGET=http://localhost:3000

# Enable/Disable API usage (when false, uses mock repositories)
VITE_USE_API=false
